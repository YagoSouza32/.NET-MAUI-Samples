<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Layouts.AbsoluteLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AbsoluteLayoutPage">

    <AbsoluteLayout Margin="20">
        <Label AbsoluteLayout.LayoutBounds="150,0,150,50" Text="Label 01" />
        <BoxView
            AbsoluteLayout.LayoutBounds="150,200"
            HeightRequest="50"
            WidthRequest="50"
            Color="CornflowerBlue" />
        <BoxView
            AbsoluteLayout.LayoutBounds="175,225"
            HeightRequest="50"
            WidthRequest="50"
            Color="red" />
        <BoxView
            AbsoluteLayout.LayoutBounds="200,250"
            HeightRequest="50"
            WidthRequest="50"
            Color="GreenYellow" />
        <BoxView
            AbsoluteLayout.LayoutBounds="225,275"
            HeightRequest="50"
            WidthRequest="50"
            Color="LightYellow" />
        <BoxView
            AbsoluteLayout.LayoutBounds="250,300"
            HeightRequest="50"
            WidthRequest="50"
            Color="Orange" />
        <BoxView
            AbsoluteLayout.LayoutBounds="275,325"
            HeightRequest="50"
            WidthRequest="50"
            Color="Black" />
        <Button
            AbsoluteLayout.LayoutBounds="0.5,0.5,200,60"
            AbsoluteLayout.LayoutFlags="PositionProportional"
            Text="Button 01" />
    </AbsoluteLayout>
</ContentPage>