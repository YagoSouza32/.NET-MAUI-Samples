<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMAUIGallery.Views.Layouts.AbsoluteLayoutPage"
             Title="AbsoluteLayoutPage">

    <AbsoluteLayout Margin="20">
        <Label Text="Label 01" AbsoluteLayout.LayoutBounds="150,0,150,50" />
        <BoxView AbsoluteLayout.LayoutBounds="150,200" Color="CornflowerBlue" WidthRequest="50" HeightRequest="50"/>
        <BoxView AbsoluteLayout.LayoutBounds="175,225" Color="red" WidthRequest="50" HeightRequest="50"/>
        <BoxView AbsoluteLayout.LayoutBounds="200,250" Color="GreenYellow" WidthRequest="50" HeightRequest="50"/>
        <BoxView AbsoluteLayout.LayoutBounds="225,275" Color="LightYellow" WidthRequest="50" HeightRequest="50"/>
        <BoxView AbsoluteLayout.LayoutBounds="250,300" Color="Orange" WidthRequest="50" HeightRequest="50"/>
        <BoxView AbsoluteLayout.LayoutBounds="275,325" Color="Black" WidthRequest="50" HeightRequest="50"/>
        <Button Text="Button 01" AbsoluteLayout.LayoutBounds="0.5,0.5,200,60" AbsoluteLayout.LayoutFlags="PositionProportional"/>
    </AbsoluteLayout>
</ContentPage>