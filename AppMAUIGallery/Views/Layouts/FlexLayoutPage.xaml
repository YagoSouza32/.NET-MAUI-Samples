<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Layouts.FlexLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="FlexLayoutPage">
    
    <FlexLayout Direction="Column" AlignItems="Start" Margin="20">

        <Label Text="AlignSelf : Start" Margin="0,5"/>
        <Label Text="Exemplo de label 001" FlexLayout.AlignSelf="Start" Padding="10" BackgroundColor="Green" />
        
        <Label Text="AlignSelf : Center" Margin="0,5"/>
        <Label Text="Exemplo de label 002" FlexLayout.AlignSelf="Center" Padding="10" BackgroundColor="LawnGreen" />

        <Label Text="AlignSelf : End" Margin="0,5"/>
        <Label Text="Exemplo de label 003" FlexLayout.AlignSelf="End" Padding="10" BackgroundColor="LimeGreen" />

        <Label Text="AlignSelf : Stretch" Margin="0,5"/>
        <Label Text="Exemplo de label 004" FlexLayout.AlignSelf="Stretch" Padding="10" BackgroundColor="DarkSlateGray" TextColor="White" />
    </FlexLayout>
    
</ContentPage>