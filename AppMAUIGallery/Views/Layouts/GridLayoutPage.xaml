<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Layouts.GridLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="GridLayoutPage">

    <Grid Margin="20" BackgroundColor="AliceBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>

        <BoxView Grid.Row="0" Grid.Column="0" Color="RoyalBlue" />       
        <BoxView Grid.Row="0" Grid.Column="1" Color="ForestGreen" WidthRequest="50" />
        <BoxView Grid.Row="0" Grid.Column="2" Color="GreenYellow" Grid.ColumnSpan="2" Grid.RowSpan="2" />        
        <BoxView Grid.Row="1" Grid.Column="0" Color="Orange" />
        <BoxView Grid.Row="1" Grid.Column="1" Color="Red" />
        <BoxView Grid.Row="2" Grid.ColumnSpan="4" Color="DimGrey" />


    </Grid>
</ContentPage>